{
  "name": "pyodin-web",
  "version": "1.0.0",
  "description": "Browser-based Samsung firmware flashing tool using WebUSB",
  "main": "index.html",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "python3 -m flask --app server.app run --host 127.0.0.1 --port 5000",
    "start": "npm run dev",
    "start:flask": "python3 -m flask --app server.app run --host 127.0.0.1 --port 5000"
  },
  "keywords": [
    "samsung",
    "odin",
    "firmware",
    "webusb",
    "flashing",
    "android"
  ],
  "author": "PyOdin Developers",
  "license": "MIT",
  "dependencies": {
    "@sboot/core": "file:packages/sboot-core"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pyodin/pyodin"
  },
  "bugs": {
    "url": "https://github.com/pyodin/pyodin/issues"
  },
  "homepage": "https://github.com/pyodin/pyodin#readme"
}
